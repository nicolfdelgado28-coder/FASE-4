"MODULO 1 EXECEPCIONES"
excepciones personalizadas para el sistema de gestión Software FJ.
Permitira diferenciar errores de negocio, validación y estado sin detener la aplicación.
"""

class SoftwareFJError(Exception):
    """Excepción base para todos los errores controlados del sistema."""
    pass

class DatoInvalidoError(SoftwareFJError):
    """Se lanza cuando un parámetro o atributo no cumple con las reglas de validación."""
    pass

class ServicioNoDisponibleError(SoftwareFJError):
    """Se lanza al intentar reservar un servicio inactivo o sin stock."""
    pass

class ReservaInvalidaError(SoftwareFJError):
    """Se lanza ante operaciones no permitidas sobre una reserva (ej. cancelar una ya cancelada)."""
    pass

class CalculoInconsistenteError(SoftwareFJError):
    """Se lanza cuando un cálculo financiero arroja valores negativos o incoherentes."""
    pass





