import logging
from abc import ABC, abstractmethod
from typing import List, Optional


# ==============================================================================
# 1. JERARQUÍA DE EXCEPCIONES PERSONALIZADAS
# ==============================================================================
class SoftwareFJError(Exception):
    """Excepción base para todos los errores controlados del sistema."""
    pass

class DatoInvalidoError(SoftwareFJError):
    """Se lanza cuando un parámetro o atributo no cumple con las reglas de validación."""
    pass

class ServicioNoDisponibleError(SoftwareFJError):
    """Se lanza al intentar reservar un servicio inactivo o sin disponibilidad."""
    pass

class ReservaInvalidaError(SoftwareFJError):
    """Se lanza ante operaciones no permitidas sobre una reserva."""
    pass

class CalculoInconsistenteError(SoftwareFJError):
    """Se lanza cuando un cálculo financiero arroja valores negativos o incoherentes."""
    pass


# ==============================================================================
# 2. CONFIGURACIÓN DEL ARCHIVO DE LOGS
# ==============================================================================
def configurar_logger(nombre_archivo: str = "sistema_fj.log") -> logging.Logger:
    """Inicializa y retorna un logger configurado para escribir eventos y errores."""
    logger = logging.getLogger("SoftwareFJ")
    logger.setLevel(logging.DEBUG)

    if not logger.handlers:
        manejador_archivo = logging.FileHandler(nombre_archivo, mode="a", encoding="utf-8")
        formato = logging.Formatter(
            "%(asctime)s | %(levelname)-8s | %(message)s",
            datefmt="%Y-%m-%d %H:%M:%S"
        )
        manejador_archivo.setFormatter(formato)
        logger.addHandler(manejador_archivo)

    return logger


