# 4. GESTOR DEL SISTEMA (LISTAS EN MEMORIA Y MANEJO AVANZADO DE EXCEPCIONES)
# ==============================================================================
class GestorSoftwareFJ:
    """Controlador principal del sistema sin uso de bases de datos."""

    def __init__(self):
        self._clientes: List[Cliente] = []
        self._servicios: List[Servicio] = []
        self._reservas: List[Reserva] = []
        self._logger = configurar_logger()
        self._logger.info("=== INICIO DE SESIÓN DEL SISTEMA SOFTWARE FJ ===")

    def registrar_cliente(self, cliente: Cliente) -> bool:
        """Registra un cliente validando duplicados con bloque try/except/else."""
        try:
            if any(c.id == cliente.id for c in self._clientes):
                raise DatoInvalidoError(f"Ya existe un cliente registrado con el ID '{cliente.id}'.")
        except SoftwareFJError as e:
            self._logger.error(f"Error al registrar cliente: {e}")
            print(f"[ERROR CONTROLADO] {e}")
            return False
        else:
            self._clientes.append(cliente)
            self._logger.info(f"Cliente registrado exitosamente -> {cliente.obtener_resumen()}")
            print(f"[OK] {cliente.obtener_resumen()}")
            return True

    def agregar_servicio(self, servicio: Servicio) -> bool:
        """Agrega un servicio al catálogo en memoria."""
        try:
            if any(s.id == servicio.id for s in self._servicios):
                raise DatoInvalidoError(f"Ya existe un servicio con el ID '{servicio.id}'.")
        except SoftwareFJError as e:
            self._logger.error(f"Error al agregar servicio: {e}")
            print(f"[ERROR CONTROLADO] {e}")
            return False
        else:
            self._servicios.append(servicio)
            self._logger.info(f"Servicio agregado -> {servicio.obtener_resumen()}")
            print(f"[OK] {servicio.obtener_resumen()}")
            return True

    def crear_reserva(
        self,
        id_reserva: str,
        id_cliente: str,
        id_servicio: str,
        duracion: int,
        descuento: float = 0.0,
        recargo_fijo: Optional[float] = None
    ) -> Optional[Reserva]:
        """
        Procesa una reserva completa utilizando try/except/else/finally
        y encadenamiento de excepciones ante fallos de búsqueda o procesamiento.
        """
        reserva_creada = None
        try:
            cliente = next((c for c in self._clientes if c.id == id_cliente), None)
            if cliente is None:
                raise DatoInvalidoError(f"Cliente con ID '{id_cliente}' no encontrado.")

            servicio = next((s for s in self._servicios if s.id == id_servicio), None)
            if servicio is None:
                raise DatoInvalidoError(f"Servicio con ID '{id_servicio}' no encontrado.")

            reserva = Reserva(id_reserva, cliente, servicio, duracion)
            reserva.procesar_y_confirmar(descuento=descuento, recargo_fijo=recargo_fijo)

        except SoftwareFJError as err:
            causa = f" | Causa interna: {err.__cause__}" if err.__cause__ else ""
            self._logger.error(f"Fallo en reserva [{id_reserva}]: {err}{causa}")
            print(f"[ERROR RESERVA {id_reserva}] {err}{causa}")
        else:
            self._reservas.append(reserva)
            reserva_creada = reserva
            self._logger.info(f"Reserva confirmada -> {reserva.obtener_resumen()}")
            print(f"[OK] {reserva.obtener_resumen()}")
        finally:
            self._logger.debug(f"Finalizó intento de transacción para reserva '{id_reserva}'.")

        return reserva_creada

    def cancelar_reserva(self, id_reserva: str) -> None:
        """Cancela una reserva existente de forma segura."""
        try:
            reserva = next((r for r in self._reservas if r.id == id_reserva), None)
            if reserva is None:
                raise ReservaInvalidaError(f"No existe la reserva '{id_reserva}'.")
            reserva.cancelar()
        except SoftwareFJError as e:
            self._logger.warning(f"No se pudo cancelar reserva '{id_reserva}': {e}")
            print(f"[ADVERTENCIA] {e}")
        else:
            self._logger.info(f"Reserva cancelada -> {reserva.obtener_resumen()}")
            print(f"[OK] Reserva {id_reserva} cancelada y servicio liberado.")


